********************************************************************************
*  igzo_2t0c_v1.lib
*  Zhu 2T0C IEDM 2026 — paper-anchored physics-based compact model, v1
*
*  Geometry (PAPER_REPORTED, fixed from Zhu Fig. 5 caption):
*    L  = 55 nm        gate length
*    CD = 50 nm        channel diameter (CAA structure)
*    t_ch = t_IGZO = 3 nm
*    t_ox = t_HfOx = 8 nm
*    W_eff = pi * CD = 157.08 nm
*
*  Subcircuit X1: 2T0C OSFET I-V only (no parasitic RC, no BTI).
*  Pins: D=drain, G=gate, S=source
*
*  Provenance: see model_equations.md
*    Geometry         : PAPER_REPORTED
*    eps_s, eps_ox    : CALIBRATION_PARAMETER (initial_guess_from_SCE_paper)
*    N_D              : CALIBRATION_PARAMETER (initial_guess_from_SCE_paper)
*    V_fb, V_th0      : CALIBRATION_PARAMETER
*    m_body           : CALIBRATION_PARAMETER (effective body factor)
*    mu_0, mu_b       : CALIBRATION_PARAMETER (initial_guess mu_b from SCE)
*    USR, E_USC       : CALIBRATION_PARAMETER (Zhu Eq. 7 mobility field dep.)
*    alpha_DIBL       : CALIBRATION_PARAMETER (SCE Eq. 11 DIBL functional form)
*    alpha_sat        : CALIBRATION_PARAMETER (V_ds,sat = alpha_sat * V_ov)
*    CLM              : CALIBRATION_EXTENSION (channel-length modulation)
*    K_pre            : CALIBRATION_PARAMETER (prefactor)
*    n_power          : CALIBRATION_EXTENSION (V_ov^n power-law)
********************************************************************************

.SUBCKT IGZO_2T0C_V1 D G S
.PARAM
+ eps_s_r   = 10
+ eps_ox_r  = 22
+ N_D_cm3   = 1e18
+ V_fb      = -0.5
+ V_th0     = 0.4
+ m_body    = 1.8
+ mu_0_cm2  = 10
+ mu_b_cm2  = 15
+ USR_mV    = 1e-14
+ E_USC     = 2.0
+ alpha_DIBL= 0.3
+ alpha_sat = 0.7
+ CLM       = 1.0
+ K_pre     = 0.3
+ n_power   = 1.5

* auxiliary nodes
* node names: n_vthr, n_vov, n_psi, n_cox, n_mu, n_vdsat, n_vde, n_ion, n_ioff, n_w, n_id

B_vthr  n_vthr  0  V = V_th0 - alpha_DIBL*V(D,S)
B_vov   n_vov   0  V = V(G,S) - V(n_vthr)
B_psi   n_psi   0  V = m_body*0.02585*ln(1+exp(min((V(G,S)-V_fb-V_th0)/(m_body*0.02585),50)))
B_cox   n_cox   0  V = eps_ox_r * 8.854187817e-12 / 8e-9
B_mu    n_mu    0  V = mu_0_cm2*1e-4 / (1 + (USR_mV * V(n_cox) * (V(G,S) - V_fb - V(n_psi)) / (eps_s_r*8.854e-12))^E_USC)
B_vdsat n_vdsat 0  V = max(alpha_sat*V(n_vov), 1e-9)
B_vde   n_vde   0  V = (V(D,S) < V(n_vdsat)) ? V(D,S) : V(n_vdsat)*(1+CLM*(V(D,S)-V(n_vdsat)))
B_ion   n_ion   0  V = ((V(n_vov) > 0) && (V(n_vde) > 0)) ? K_pre * (157.0796e-9/(55e-9)) * V(n_mu) * V(n_cox) * pow(V(n_vov), n_power) * V(n_vde) : 0
B_ioff  n_ioff  0  V = (157.0796e-9/(55e-9)) * mu_b_cm2*1e-4 * V(n_cox) * (m_body*0.02585)^2
+                     * exp(min((V(G,S)-V(n_vthr))/(m_body*0.02585), 10))
+                     * (1 - exp(-V(D,S)/0.02585))
B_w     n_w     0  V = 1 / (1 + exp(-V(n_vov) / (m_body*0.02585)))
B_id    n_id    0  V = V(n_w) * V(n_ion) + (1-V(n_w)) * V(n_ioff)

G_ID D S CUR = V(n_id)

.ENDS IGZO_2T0C_V1
