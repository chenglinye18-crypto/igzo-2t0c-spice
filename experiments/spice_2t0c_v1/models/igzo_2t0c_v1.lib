********************************************************************************
*  igzo_2t0c_v1.lib
*  Zhu 2T0C IEDM 2026 — paper-anchored physics-based compact model, v1.1
*
*  v1.1 changes from v1:
*    - V_d_eff formula changed from piecewise min(Vd, Vdsat) to a smooth-min:
*        V_d_eff = Vd * Vdsat / sqrt(Vd^2 + Vdsat^2)
*      This captures the soft saturation observed in Zhu Id-Vd at Vg=2
*      (Id grows only 1.43x from Vd=0.1 to Vd=1, not 10x from linear).
*    - 5 calibration parameters re-tuned (n_power, K_pre, alpha_sat,
*      CLM, alpha_DIBL). All other parameters frozen from v1.
*    - v1.1 key-bias errors < 10% (was 20-100% in v1).
*
*  Geometry (PAPER_REPORTED, fixed from Zhu Fig. 5 caption):
*    L  = 55 nm        gate length
*    CD = 50 nm        channel diameter (CAA structure)
*    t_ch = t_IGZO = 3 nm
*    t_ox = t_HfOx = 8 nm
*    W_eff = pi * CD = 157.08 nm
*
*  Subcircuit X1: 2T0C OSFET I-V only (no parasitic RC, no BTI).
*  Pins: D=drain, G=gate, S=source
********************************************************************************

.SUBCKT IGZO_2T0C_V1 D G S
.PARAM
+ eps_s_r   = 10
+ eps_ox_r  = 22
+ N_D_cm3   = 1e18
+ V_fb      = -0.5
+ V_th0     = 0.4
+ m_body    = 1.8
+ mu_0_cm2  = 80
+ mu_b_cm2  = 15
+ USR_mV    = 1e-14
+ E_USC     = 1.5
+ alpha_DIBL= 0.08
+ alpha_sat = 0.03
+ CLM       = 0.0
+ K_pre     = 0.7
+ n_power   = 1.7

* auxiliary nodes (named to avoid conflict)
B_vthr  n_vthr  0  V = V_th0 - alpha_DIBL*V(D,S)
B_vov   n_vov   0  V = V(G,S) - V(n_vthr)
B_psi   n_psi   0  V = m_body*0.02585*ln(1+exp(min((V(G,S)-V_fb-V_th0)/(m_body*0.02585),50)))
B_cox   n_cox   0  V = eps_ox_r * 8.854187817e-12 / 8e-9
B_mu    n_mu    0  V = mu_0_cm2*1e-4 / (1 + (USR_mV * V(n_cox) * (V(G,S) - V_fb - V(n_psi)) / (eps_s_r*8.854e-12))^E_USC)
B_vdsat n_vdsat 0  V = max(alpha_sat*V(n_vov), 1e-9)

* v1.1: smooth-min V_d_eff = Vd * Vdsat / sqrt(Vd^2 + Vdsat^2)
B_vde   n_vde   0  V = V(D,S) * V(n_vdsat) / sqrt(V(D,S)*V(D,S) + V(n_vdsat)*V(n_vdsat))

* v1.1: CLM applied as additive linear beyond Vdsat
B_vde2  n_vde2  0  V = (V(D,S) > V(n_vdsat)) ? V(n_vde) + CLM*(V(D,S) - V(n_vdsat)) : V(n_vde)

* on-state current (Zhu Eq. 6 anchored form, with V_ov^n_power)
B_ion   n_ion   0  V = ((V(n_vov) > 0) && (V(n_vde2) > 0)) ? K_pre * (157.0796e-9/(55e-9)) * V(n_mu) * V(n_cox) * pow(V(n_vov), n_power) * V(n_vde2) : 0

* off-state current (SCE Eq. 9 universal form, clamped)
B_ioff  n_ioff  0  V = (157.0796e-9/(55e-9)) * mu_b_cm2*1e-4 * V(n_cox) * (m_body*0.02585)^2
+                     * exp(min((V(G,S)-V(n_vthr))/(m_body*0.02585), 10))
+                     * (1 - exp(-V(D,S)/0.02585))

* smooth blend (logistic)
B_w     n_w     0  V = 1 / (1 + exp(-V(n_vov) / (m_body*0.02585)))

* total drain current
B_id    n_id    0  V = V(n_w) * V(n_ion) + (1-V(n_w)) * V(n_ioff)

G_ID D S CUR = V(n_id)

.ENDS IGZO_2T0C_V1
